        "fmt"
      ]
    ]
  },
  {
    "id": "in_truth",
    "type": "mqtt in",
    "z": "tab1",
    "name": "sim ground truth",
    "topic": "sim/legacy_cnc_01/truth",
    "qos": "1",
    "datatype": "auto-detect",
    "broker": "broker",
    "x": 170,
    "y": 140,
    "wires": [
