  },
  {
    "id": "in_factory",
    "type": "mqtt in",
    "z": "tab1",
    "name": "factory/legacy_cnc_01/#",
    "topic": "factory/legacy_cnc_01/#",
    "qos": "1",
    "datatype": "auto-detect",
