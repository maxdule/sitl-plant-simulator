        "fmt"
      ]
    ]
  },
  {
    "id": "fmt",
    "type": "function",
    "z": "tab1",
    "name": "to line protocol",
    "func": "// MQTT message -> InfluxDB line protocol. Time stamp = Node-RED arrival time (ms); alarm points are kept strictly increasing.\nconst kind = msg.topic.split(\"/\").pop();\nconst p = msg.payload;\nconst now = Date.now();\nconst tag = \"asset=legacy_cnc_01\";\nconst num = o => Object.entries(o).filter(([k, v]) => typeof v === \"number\" && isFinite(v)).map(([k, v]) => `${k}=${v}`);\nconst lines = [];\n\nif (kind === \"telemetry\") {\n    lines.push(`telemetry,${tag} ${num(p).join(\",\")} ${now}`);\n} else if (kind === \"alarms\") {\n    const last = context.get(\"lastAlarmTs\") || 0;\n    const ts = Math.max(now, last + 1);   // never two alarm points in the same ms (InfluxDB would overwrite)\n    context.set(\"lastAlarmTs\", ts);\n    lines.push(`alarms,${tag},alarm_class=${p.alarm_class} alarm_id=\"${p.alarm_id}\",transition=\"${p.transition}\",${num(p).join(\",\")} ${ts}`);\n} else if (kind === \"state\") {\n    lines.push(`state,${tag} label=\"${p}\" ${now}`);\n} else if (kind === \"truth\") {\n    lines.push(`truth,${tag},fault=${p.fault} event=\"${p.event}\",seq=${p.seq},sim_t=${p.sim_t} ${now}`);\n} else if (kind === \"snapshot\") {\n    const last = p.sim_t[p.sim_t.length - 1];\n    p.seq.forEach((seq, i) => {          // one point per sample, placed relative to the arrival time\n        const ts = Math.round(now - (last - p.sim_t[i]) * 1000);\n        lines.push(`snapshot,${tag},alarm_class=${p.alarm_class} vibration_mm_s=${p.vibration_mm_s[i]},seq=${seq} ${ts}`);\n    });\n}\nif (lines.length === 0) { return null; }\nmsg.payload = lines.join(\"\\n\");\nmsg.headers = {\"Authorization\": \"Token sitl-token\", \"Content-Type\": \"text/plain\"};\nreturn msg;",
    "outputs": 1,
    "x": 400,
    "y": 110,
    "wires": [
      [
        "influx"
      ]
    ]
  },
  {
    "id": "influx",
    "type": "http request",
    "z": "tab1",
    "name": "write to InfluxDB",
    "method": "POST",
    "ret": "txt",
    "url": "http://influxdb:8086/api/v2/write?org=sitl&bucket=factory&precision=ms",
    "x": 620,
    "y": 110,
    "wires": [
      [
        "err"
      ]
    ]
  },
